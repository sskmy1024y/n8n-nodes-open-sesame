{
	"name": "n8n-nodes-open-sesame",
	"version": "0.3.0",
	"description": "n8n trigger node for SESAME smart lock lock/unlock events (realtime state push)",
	"license": "MIT",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"sesame",
		"smart-lock",
		"websocket"
	],
	"bin": {
		"n8n-nodes-open-sesame": "bin/n8n-nodes-open-sesame.mjs"
	},
	"scripts": {
		"build": "tsc && cp nodes/SesameTrigger/sesame.svg dist/nodes/SesameTrigger/",
		"dev": "tsc --watch",
		"lint": "tsc --noEmit",
		"pack": "npm run build && node scripts/pack.mjs"
	},
	"files": [
		"dist",
		"bin"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/SesameApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SesameTrigger/SesameTrigger.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"@sesame-kit/core": "^0.7.0"
	},
	"devDependencies": {
		"n8n-workflow": "*",
		"tsx": "^4.21.0",
		"typescript": "~5.7.0"
	}
}
